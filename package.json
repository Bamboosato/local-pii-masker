{
  "name": "local-pii-masker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit:dependencies": "tsx scripts/security/runDependencyAudit.ts",
    "benchmark:core": "tsx scripts/performance/runCoreBenchmark.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "evaluate:ner": "tsx scripts/ner-evaluation/run.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:e2e:dev": "playwright test --config=playwright.dev.config.ts",
    "test:e2e:edge": "npm run build && playwright test --project=msedge",
    "test:phase5": "npm test && npm run test:e2e:dev && npm run test:e2e && npm run benchmark:core",
    "test:security": "vitest run scripts/security",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@huggingface/transformers": "^4.3.0",
    "lucide-react": "^1.24.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  }
}
